{
  "name": "office-easy-formula",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "test": "node --import tsx --test test/*.ts",
    "certs": "office-addin-dev-certs install",
    "icons": "node scripts/make-icons.mjs",
    "sideload": "bash scripts/sideload.sh"
  },
  "dependencies": {
    "office-addin-dev-certs": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/office-js": "^1.0.556",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
