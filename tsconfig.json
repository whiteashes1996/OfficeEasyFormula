{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "office-js"],
    "isolatedModules": true
  },
  "include": ["taskpane/**/*.ts", "src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
